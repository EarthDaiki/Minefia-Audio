{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minefia Audio",
  "version": "0.1.0",
  "identifier": "com.minefia.audio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Minefia Audio",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#f7f7f3"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/recordings/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Streaming audio transcription",
    "longDescription": "Securely transcribe audio with streaming output and automatic size optimization.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  }
}
